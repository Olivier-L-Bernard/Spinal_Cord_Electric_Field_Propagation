alphaMB= [0.1,0.1,0.3,0.02]# Paramètre Gabriel et al 1996 (Dielectric properties of Biological tissues III) et (Compilation Dielectric Properties Body Tissues Rf And Microwave Frequencies)
DpermMB=[32,100,4E4,3.5E7] #
tauMB = [7.96E-12,7.96E-9,53.05E-6,7.958E-3] #
sigmaMB = 0.02

alphaMG= [0.1,0.15,0.22,0.00] # Paramètre Gabriel et al 1996 (Dielectric properties of Biological tissues III) et (Compilation Dielectric Properties Body Tissues Rf And Microwave Frequencies)
DpermMG=[45,400,2E5,4.5E7]
tauMG = [7.96E-12,15.92E-9,106.1E-6,5.305E-3] 
sigmaMG = 0.02

alphaDu= [0.15,0.1,0.2,0] # Paramètre Gabriel et al 1996 (Dielectric properties of Biological tissues III) et (Compilation Dielectric Properties Body Tissues Rf And Microwave Frequencies)
perminfDu = 4
DpermDu=[40,200,10000,1E6] 
tauDu = [7.958E-12,7.958E-9,1.592E-4,1.592E-2]
sigmaDu = 0.06

sigmaLCF = 1.7 # Paramètre C. Gabriel et al 1996 (Compilation Dielectric Properties Body Tissues Rf And Microwave Frequencies)
alphaLCF= [0.1,0,0,0]
perminfLCF = 4
DpermLCF=[65,40,0,0]
tauLCF = [7.958E-12,1.592E-9,1.592E-4,1.592E-2]

perminf = 4
permvide = 8.8541878128E-12 #Constante de la nature

T4cMg = [] #Listes des taux de transmissions
T4cMg1 = []
T4cMg2 = []
T4cMg3 = []
T4cMgP = []
T4cMgP2 = []
T3cMb = []
T3cMb2 = []
T3cMg = []
T2cCSf = []
pp=[]
omega2=np.logspace(1,12,num=95, endpoint=True, base=10.0, dtype=None, axis=0) #Range en fréquence (Hz)
for w in omega2: #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
				 #Autres références pour comparer: Kordic 2023 (Dielectric Spectroscopy Shows...) [WM, GM]; Matkovic 2022 (Complex Permittivity of Ex-Vivo...) [GM, WM]; 
				 #								   Peynman 2009 (Variation of the Dielectric...)- Conductivité meh; Nowak 2011 (Optimizing a Rodent Model...); Chen 2021 (An Amplitude‑Based Characteristic ) [Dura, CSF];
				 # 								   Sollehudin2014 (Characterization_of_Human...)
	sigmMG =0
	sigDu =0
	sigMb =0
	sigLCF =0
	varepMG = 0
	varepMB = 0
	varepDu = 0
	varepLCF= 0
	for i in range(len(alphaMG)):
		varepMG +=  DpermMG[i]/(1+(1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i]))  #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
		varepDu +=  DpermDu[i]/(1+(1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i]))  #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
		varepMB +=  DpermMB[i]/(1+(1j*2*np.pi*w*tauMB[i])**(1-alphaMB[i]))  #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
		varepLCF += DpermLCF[i]/(1+(1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i]))  #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
		sigmMG += 2*np.pi*w*((1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i])).imag*DpermMG[i]/abs(1+(1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i]))**2
		sigDu +=  2*np.pi*w*((1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i])).imag*DpermDu[i]/abs(1+(1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i]))**2
		sigMb += 2*np.pi*w*((1j*2*np.pi*w*tauMB[i])**(1-alphaMB[i])).imag*DpermMB[i]/abs(1+(1j*2*np.pi*w*tauMB[i])**(1-alphaMB[i]))**2
		sigLCF += 2*np.pi*w*((1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i])).imag*DpermLCF[i]/abs(1+(1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i]))**2

	sigmMG2 = sigmaMG + permvide * sigmMG
	sigDu2 = sigmaDu + permvide*sigDu
	sigMb2 = sigmaMB + permvide*sigMb
	sigLCF2 = sigmaLCF + permvide*sigLCF 

	varepMBB  = perminf + varepMB + sigmaMB / (1j * (w * 2 * np.pi * permvide))
	varepMGG  = perminf + varepMG + sigmaMG / (1j * (w * 2 * np.pi * permvide))
	varepDuu  = perminfDu + varepDu + sigmaDu / (1j * (w * 2 * np.pi * permvide))
	varepLCFF = perminfLCF + varepLCF + sigmaLCF / (1j * (w * 2 * np.pi * permvide))

	varepMB2 = varepMBB.real + 1j*abs(varepMBB.imag) 
	varepMG2 = varepMGG.real + 1j*abs(varepMGG.imag) 
	varepDu2 = varepDuu.real + 1j*abs(varepDuu.imag)
	varepLCF2 = varepLCFF.real + 1j*abs(varepLCFF.imag)

	T4cMgP.append(-1j*2*np.pi*w*permvide*varepMG2) # GM # Cole-Cole model calculates Varep = varep' - i varep", whereas physics is Varep = varep' + i varep" 
	T4cMgP2.append(-1j*2*np.pi*w*permvide*varepMB2) # WM # the minus sign is there to correct the engineering anotation from permittivity to physicist standard anotation
	T3cMb2.append(-1j*2*np.pi*w*permvide*varepDu2) # Dura # it leads to the proper sigma [...] - varep' format expected in physics litterature
	T3cMg.append(-1j*2*np.pi*w*permvide*varepLCF2) # CSF 
	
font=31
