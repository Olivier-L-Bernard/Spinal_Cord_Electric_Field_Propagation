#Parametres du modele de Cole-Cole modifie. Voir Gabriel (article)
alphaMB= [0.1,0.1,0.3,0.02]#
DpermMB=[32,100,4E4,3.5E7] #
tauMB = [7.96E-12,7.96E-9,53.05E-6,7.958E-3] #
sigmaMB = 0.02

alphaMG= [0.1,0.15,0.22,0.00] # 
DpermMG=[45,400,2E5,4.5E7] #
tauMG = [7.96E-12,15.92E-9,106.1E-6,5.305E-3] #
sigmaMG = 0.2

alphaDu= [0.15,0.1,0.2,0] #
perminfDu = 4
DpermDu=[40,200,10000,1E6] #
tauDu = [7.958E-12,7.958E-9,1.592E-4,1.592E-2] #
sigmaDu = 0.02

sigmaLCF = 1.7
alphaLCF= [0.1,0,0,0]
perminfLCF = 4
DpermLCF=[65,40,0,0]
tauLCF = [7.958E-12,1.592E-9,1.592E-4,1.592E-2]

perminf = 4
permvide = 8.8541878128E-12 #varepsilon_0 ou permitivite vide
cc=2.98E8 #Vitesse lumiere dans le vide en m/s

#Liste des différentes variables
varepirMB=[]
varepiiMB=[]
difMB=[]
varepirMG=[]
varepiiMG=[]
varepirDu=[]
varepiiDu=[]
varepirLCF=[]
varepiiLCF=[]

difMG=[]
difDu=[]
difLCF=[]
TRMG= []
TRMB= []
TRML=[]
TRMLB =[]
TRMDu=[]

NMB= []
NMG=[]
NLCF=[]
NDU=[]
NMBii= []
NMGii=[]
NLCFii=[]
NDUii=[]
l=0
omega2=np.logspace(1,16,num=90, endpoint=True, base=10.0, dtype=None, axis=0)
for w in omega2:
	#print('Frequence:',w)
	varepMG = 0
	varepMB = 0
	varepDu =0
	varepLCF=0
	kG=0
	kB=0
	for i in range(len(alphaMG)):
		varepMG +=  DpermMG[i]/(1+(1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i]))
		varepDu +=  DpermDu[i]/(1+(1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i]))
		varepMB +=  DpermMB[i]/(1+(1j*2*np.pi*w*tauMB[i])**(1-alphaMB[i]))
		varepLCF += DpermLCF[i]/(1+(1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i]))
	varepMB2 = perminf+ varepMB + sigmaMB/(1j*(2*np.pi*w*permvide))
	varepirMB.append(varepMB2.real)
	varepiiMB.append(varepMB2.imag)
	varepMG2 = perminf+ varepMG + sigmaMG/(1j*(2*np.pi*w*permvide))
	varepirMG.append(varepMG2.real)
	varepiiMG.append(varepMG2.imag)
	varepDu2 = perminfDu+ varepDu + sigmaDu/(1j*(2*np.pi*w*permvide))
	varepirDu.append(varepDu2.real)
	varepiiDu.append(varepDu2.imag)
	varepLCF2 = perminfLCF+ varepLCF + sigmaLCF/(1j*(2*np.pi*w*permvide))
	varepirLCF.append(varepLCF2.real)
	varepiiLCF.append(varepLCF2.imag)
#Exponentielle pour corriger les indices de diffraction	
	alphaW= 0.5 #
	alphaG= 0.43475#
	alphaL= 0.42#
	alphaD= 0.55#
#Calcul des indices de diffraction	
	MGA=((varepMG2.imag))
	nMG=(np.sqrt(0.5*np.sqrt(varepMG2.real**2 + MGA**2) +0.5*varepMG2.real))**(alphaG) #
	nMGii=   (np.sqrt(0.5*np.sqrt(varepMG2.real**2 + MGA**2) -0.5*varepMG2.real))**2 #
	NMG.append(nMG)
	NMGii.append(nMGii)
	MBA= (varepMB2.imag)
	#print(type(MBA))
	nMB= (np.sqrt(0.5*(np.sqrt(varepMB2.real**2 + MBA**2) +varepMB2.real)))**(alphaW)#
	nMBii= 2.5*(np.sqrt(0.5*(np.sqrt(varepMB2.real**2 + MBA**2) -varepMB2.real)))**2#
	NMB.append(nMB)
	NMBii.append(nMBii)
	DUA=(varepDu2.imag)
	nDu= (np.sqrt(0.5*np.sqrt(varepDu2.real**2 + DUA**2) +0.5*varepDu2.real ))**(alphaD)  #
	nDuii= (np.sqrt(0.5*np.sqrt(varepDu2.real**2 + DUA**2) -0.5*varepDu2.real ))*np.exp(-w/0.63E14) #
	NDU.append(nDu)
	NDUii.append(nDuii)
	LCFA=(varepLCF2.imag)
	nLCF= (np.sqrt(0.5*np.sqrt(varepLCF2.real**2 + LCFA**2) +0.5*varepLCF2.real))**(alphaL) #
	nLCFii= (np.sqrt(0.5*np.sqrt(varepLCF2.real**2 + LCFA**2) -0.5*varepLCF2.real))  #
	NLCF.append(nLCF)
	NLCFii.append(nLCFii)
	l+=1
#Interpolation pour pouvoir calculer les valeurs des n' et n" afin de les comparer avec les resultats de la litterature
int_LCF = interp1d(omega2, NLCF, 'linear', fill_value='extrapolate')
int_LCFi = interp1d(omega2, NLCFii, 'linear', fill_value='extrapolate')
int_Du = interp1d(omega2, NDU, 'linear', fill_value='extrapolate')
int_Dui = interp1d(omega2, NDUii, 'linear', fill_value='extrapolate')
int_MB = interp1d(omega2, NMB, 'linear', fill_value='extrapolate')
int_MBi = interp1d(omega2, NMBii, 'linear', fill_value='extrapolate')
int_MG = interp1d(omega2, NMG, 'linear', fill_value='extrapolate')
int_MGi = interp1d(omega2, NMGii, 'linear', fill_value='extrapolate')#3.47E-6 970nm 3.1E14Hz

