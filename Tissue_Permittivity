l=0
print(np.pi)
omega2=np.logspace(1,11,num=60, endpoint=True, base=10.0, dtype=None, axis=0)
for w in omega2:
	#print('Frequence:',w)
	varepMG = 0
	varepMB = 0
	varepDu =0
	varepLCF=0
	kG=0
	kB=0
	for i in range(len(alphaMG)):
		varepMG +=  DpermMG[i]/(1+(1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i]))  
		varepMB +=  DpermMB[i]/(1+(1j*w*2*np.pi*tauMB[i])**(1-alphaMB[i]))
		varepLCF += DpermLCF[i]/(1+(1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i])) 
		varepDu +=  DpermDu[i]/(1+(1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i])) 
		#varep += varep2
		#print(varepMG)
		#print(varepDu)
	varepMB2 = perminf+ varepMB + sigmaMB/(1j*(2*np.pi*w*permvide))
	varepirMB.append(varepMB2.real)
	varepiiMB.append(varepMB2.imag)
	varepMG2 = perminf+ varepMG+ sigmaMG/(1j*(2*np.pi*w*permvide))# + sigmaMG/(1j*(2*np.pi*w*permvide))
	varepirMG.append(varepMG2.real)
	varepiiMG.append(varepMG2.imag)
	varepDu2 = perminfDu+ varepDu + sigmaDu/(1j*(2*np.pi*w*permvide))
	varepirDu.append(varepDu2.real)
	varepiiDu.append(varepDu2.imag)
	varepLCF2 = perminfLCF+ varepLCF + sigmaLCF/(1j*(2*np.pi*w*permvide))
	varepirLCF.append(varepLCF2.real)
	varepiiLCF.append(varepLCF2.imag)
	#print(np.arctan(varepLCF2.imag/varepLCF2.real))

	TRMG.append(varepMG2.real)
	TRMDu.append(varepDu2.real)
	TRMB.append(varepMB2.real)
	TRML.append(varepLCF2.real)
	TRMGii.append(abs(varepMG2.imag))
	TRMDuii.append(abs(varepDu2.imag))
	TRMBii.append(abs(varepMB2.imag))
	TRMLii.append(abs(varepLCF2.imag))
	l+=1

