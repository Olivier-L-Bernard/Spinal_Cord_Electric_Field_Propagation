NMGii=[]
NLCFii=[]
NDUii=[]
l=0
omega2=np.logspace(1,11,num=90, endpoint=True, base=10.0, dtype=None, axis=0)
for w in omega2:
	#print('Frequence:',w)
	varepMG = 0
	varepMB = 0
	varepDu =0
	varepLCF=0
	kG=0
	kB=0
	for i in range(len(alphaMG)):
		varepMG +=  DpermMG[i]/(1+(1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i]))
		varepDu +=  DpermDu[i]/(1+(1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i]))
		varepMB +=  DpermMB[i]/(1+(1j*2*np.pi*w*tauMB[i])**(1-alphaMB[i]))
		varepLCF += DpermLCF[i]/(1+(1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i]))
	varepMB2 = perminf+ varepMB + sigmaMB/(1j*(2*np.pi*w*permvide))
	varepirMB.append(varepMB2.real)
	varepiiMB.append(varepMB2.imag)
	varepMG2 = perminf+ varepMG + sigmaMG/(1j*(2*np.pi*w*permvide))
	varepirMG.append(varepMG2.real)
	varepiiMG.append(varepMG2.imag)
	varepDu2 = perminfDu+ varepDu + sigmaDu/(1j*(2*np.pi*w*permvide))
	varepirDu.append(varepDu2.real)
	varepiiDu.append(varepDu2.imag)
	varepLCF2 = perminfLCF+ varepLCF + sigmaLCF/(1j*(2*np.pi*w*permvide))
	varepirLCF.append(varepLCF2.real)
	varepiiLCF.append(varepLCF2.imag)
#Exponentielle pour corriger les indices de diffraction	
	alphaW= 1 #0.5 #
	alphaG= 1 #0.43475#
	alphaL= 1 #0.42#
	alphaD= 1 #0.55#
#Calcul des indices de diffraction	
	MGA=((varepMG2.imag))
	nMG=(np.sqrt(0.5*np.sqrt(varepMG2.real**2 + MGA**2) +0.5*varepMG2.real))**(alphaG) #- ((2*np.pi*1E8)/w)*(np.sqrt(0.5*(np.sqrt(varepMG2.real**2 + MGA**2) +varepMG2.real)))#+varepMG2.real)# ((0.5*4*np.pi*np.pi*w**2   *1E-12*varepMG2.real*((1+ (sigmaMG/(2*np.pi*w*varepMG2.real))**2)**(1/2)+1))**(1/2))#
	nMGii=   (np.sqrt(0.5*np.sqrt(varepMG2.real**2 + MGA**2) -0.5*varepMG2.real))**1#2 #/ (w/(2*np.pi*1E14))*(np.sqrt(0.5*(np.sqrt(varepMG2.real**2 + MGA**2) +varepMG2.real)))**(alphaG)*np.exp(-w/(2*np.pi*1E14))#**(0.08) #2.99E8*np.sqrt(varepMG2.real*8.8E-12 *1E-8 /2)*np.sqrt(np.sqrt(1+ (sigmaMG/(w*varepMG2.real*8E-12  ) )**2 )) #**(alphaG) #  ((0.5*4*np.pi*np.pi*w**2   *1E-20*varepMG2.real*((1+ (sigmaMG/(2*np.pi*w*permvide*varepMG2.real))**2)**(1/2)-1))**(1/2))#
	NMG.append(nMG)
	NMGii.append(nMGii)
	MBA= (varepMB2.imag)
	#print(type(MBA))
	nMB= (np.sqrt(0.5*(np.sqrt(varepMB2.real**2 + MBA**2) +varepMB2.real)))**(alphaW)#**(alphaW)  #- (w/(2*np.pi*25.4E12))*(np.sqrt(0.5*(np.sqrt(varepMB2.real**2 + MBA**2) +varepMB2.real)))**(alphaW)*np.exp(-w/(2*np.pi*25.4E12)) #+varepMB2.real)
	nMBii= 2.5*(np.sqrt(0.5*(np.sqrt(varepMB2.real**2 + MBA**2) -varepMB2.real)))**1#2#* (w/(2*np.pi*1E12))*(np.sqrt(0.5*(np.sqrt(varepMB2.real**2 + MBA**2) +varepMB2.real)))**(alphaW)*np.exp(-w/(2*np.pi*1E12))#**(0.2)#1.09)#**(alphaW) #+varepMB2.real)
	NMB.append(nMB)
	NMBii.append(nMBii)
	DUA=(varepDu2.imag)
	nDu= (np.sqrt(0.5*np.sqrt(varepDu2.real**2 + DUA**2) +0.5*varepDu2.real ))**(alphaD)  #- (w/(2*np.pi*1E14))*(np.sqrt(0.5*(np.sqrt(varepDu2.real**2 + DUA**2) +varepDu2.real)))**(alphaD)*np.exp(-w/(2*np.pi*1E14)) #lumi*(varepDu2.real- DUA/(0.5*w**2 *Ordg*varepDu2.real*((1+ (sigmaDu/(w*varepDu2.real*ordre2))**2)**(1/2)-1))**(1/2) )**(1/2)
	nDuii= (np.sqrt(0.5*np.sqrt(varepDu2.real**2 + DUA**2) -0.5*varepDu2.real ))*1#np.exp(-w/0.63E14) #-np.exp(-1/w)*(np.sqrt(0.5*(np.sqrt(varepDu2.real**2 + DUA**2) +varepDu2.real)))**(alphaD)#**(0.3)#2.2)#**(alphaD) #
	NDU.append(nDu)
	NDUii.append(nDuii)
	LCFA=(varepLCF2.imag)
	nLCF= (np.sqrt(0.5*np.sqrt(varepLCF2.real**2 + LCFA**2) +0.5*varepLCF2.real))**(alphaL) #- (w/(2*np.pi*2E11))*(np.sqrt(0.5*(np.sqrt(varepLCF2.real**2 + LCFA**2) +varepLCF2.real)))**(alphaL)*np.exp(-w/(2*np.pi*1E12)) #lumi*(varepLCF2.real- LCFA/(0.5*w**2  *Ordg *varepLCF2.real*((1+ (sigmaLCF/(w*varepLCF2.real*ordre2))**2)**(1/2)-1))**(1/2))**(1/2)
	nLCFii= (np.sqrt(0.5*np.sqrt(varepLCF2.real**2 + LCFA**2) -0.5*varepLCF2.real))  #+ (w/(0.5E12))*(np.sqrt(0.5*(np.sqrt(varepLCF2.real**2 + LCFA**2) +varepLCF2.real)))**(alphaL)*np.exp(-w/(1E12))#**(0.46)#1.95)#**(alphaL)
	NLCF.append(nLCF)
	NLCFii.append(nLCFii)
	l+=1
#Interpolation pour pouvoir calculer les valeurs des n' et n" afin de les comparer avec les resultats de la litterature
int_LCF = interp1d(omega2, NLCF, 'linear', fill_value='extrapolate')
int_LCFi = interp1d(omega2, NLCFii, 'linear', fill_value='extrapolate')
