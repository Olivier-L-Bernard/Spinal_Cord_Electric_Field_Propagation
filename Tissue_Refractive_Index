#Parametres du modele de Cole-Cole modifie. Voir Gabriel (article)
alphaMB= [0.1,0.1,0.3,0.02]#
DpermMB=[32,100,4E4,3.5E7] #
tauMB = [7.96E-12,7.96E-9,53.05E-6,7.958E-3] #
sigmaMB = 0.02

alphaMG= [0.1,0.15,0.22,0.00] # DpermMG[i]/(1+(1j*w*tauMG[i])**(1-alphaMG[i]))   [0.1,0.15,0.12,0.10] 0.3,
DpermMG=[45,400,2E5,4.5E7] #
tauMG = [7.96E-12,15.92E-9,106.1E-6,5.305E-3] #
sigmaMG = 0.2

alphaDu= [0.15,0.1,0.2,0] #
perminfDu = 4
DpermDu=[40,200,10000,1E6] #
tauDu = [7.958E-12,7.958E-9,1.592E-4,1.592E-2] #
sigmaDu = 0.02

sigmaLCF = 1.7
alphaLCF= [0.1,0,0,0]
perminfLCF = 4
DpermLCF=[65,40,0,0]
tauLCF = [7.958E-12,1.592E-9,1.592E-4,1.592E-2]

perminf = 4
permvide = 8.8541878128E-12 #varepsilon_0 ou permitivite vide
cc=2.98E8 #Vitesse lumiere dans le vide en m/s

#Liste des différentes variables
varepirMB=[]
varepiiMB=[]
difMB=[]
varepirMG=[]
varepiiMG=[]
varepirDu=[]
varepiiDu=[]
varepirLCF=[]
varepiiLCF=[]

difMG=[]
difDu=[]
difLCF=[]
