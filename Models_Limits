for w in omega2: #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
				 #Autres références pour comparer: Kordic 2023 (Dielectric Spectroscopy Shows...) [WM, GM]; Matkovic 2022 (Complex Permittivity of Ex-Vivo...) [GM, WM]; 
				 #								   Peynman 2009 (Variation of the Dielectric...)- Conductivité meh; Nowak 2011 (Optimizing a Rodent Model...); Chen 2021 (An Amplitude‑Based Characteristic ) [Dura, CSF];
				 # 								   Sollehudin2014 (Characterization_of_Human...)
	sigmMG =0
	sigDu =0
	sigMb =0
	sigLCF =0
	varepMG = 0
	varepMB = 0
	varepDu = 0
	varepLCF= 0
	for i in range(len(alphaMG)):
		varepMG +=  DpermMG[i]/(1+(1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i]))  #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
		varepDu +=  DpermDu[i]/(1+(1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i]))  #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
		varepMB +=  DpermMB[i]/(1+(1j*2*np.pi*w*tauMB[i])**(1-alphaMB[i]))  #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
		varepLCF += DpermLCF[i]/(1+(1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i]))  #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
		sigmMG += 2*np.pi*w*((1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i])).imag*DpermMG[i]/abs(1+(1j*2*np.pi*w*tauMG[i])**(1-alphaMG[i]))**2
		sigDu +=  2*np.pi*w*((1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i])).imag*DpermDu[i]/abs(1+(1j*2*np.pi*w*tauDu[i])**(1-alphaDu[i]))**2
		sigMb += 2*np.pi*w*((1j*2*np.pi*w*tauMB[i])**(1-alphaMB[i])).imag*DpermMB[i]/abs(1+(1j*2*np.pi*w*tauMB[i])**(1-alphaMB[i]))**2
		sigLCF += 2*np.pi*w*((1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i])).imag*DpermLCF[i]/abs(1+(1j*2*np.pi*w*tauLCF[i])**(1-alphaLCF[i]))**2

	sigmMG2 = sigmaMG + permvide * sigmMG
	sigDu2 = sigmaDu + permvide*sigDu
	sigMb2 = sigmaMB + permvide*sigMb
	sigLCF2 = sigmaLCF + permvide*sigLCF 
	varepMB2 = perminf+ varepMB  + sigmaMB/(1j*(w*2*np.pi*permvide)) #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
	varepMG2 = perminf+ varepMG  + sigmaMG/(1j*(w*2*np.pi*permvide)) #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996 
	varepDu2 = perminfDu+ varepDu  + sigmaDu/(1j*(w*2*np.pi*permvide)) #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996
	varepLCF2 = perminfLCF+ varepLCF  + sigmaLCF/(1j*(w*2*np.pi*permvide)) #Calculs de permitivité réel et imaginaire avec loi de Cole-Cole modifié, voir les articles de C. et S. Gabriel 1996

	lumiere = 2.998E8 #m/s
	alphaW= 0.5 # Paramètre ajustement partie réel de n ; Biswald 2008 (je l'aime pas tant ce papier), Jacques 2013
	alphaG= 0.43475 # Paramètre ajustement partie réel de n ; Biswald 2008 (je l'aime pas tant ce papier), Jacques 2013
	alphaL= 0.42 # Paramètre ajustement partie réel de n ; Penfold 1929 - CSF (refractive index...); Khan 2021
	alphaD= 0.55 # Paramètre ajustement partie réel de n ; Nagel 2018 et Genina 2005

	n0= (np.sqrt(0.5*(np.sqrt(preleci(w)**2 + pieleci(w)**2) +preleci(w))))   # 
	n0ii= (np.sqrt(0.5*(np.sqrt(preleci(w)**2 + pieleci(w)**2) -preleci(w))))  # 
	
	MBA= (varepMB2.imag)
	nMB= (np.sqrt(0.5*(np.sqrt(varepMB2.real**2 + MBA**2) +varepMB2.real)))**(alphaW)   # Biswald 2008 (je l'aime pas tant ce papier), Jacques 2013
	nMBii= 2.5*(np.sqrt(0.5*(np.sqrt(varepMB2.real**2 + MBA**2) -varepMB2.real)))**2   # Gebhart 2006 ; Yaroslavsky2002 (Optical properties of selected native...)
	MGA=abs((varepMG2.imag))
	nMG= (np.sqrt(0.5*np.sqrt(varepMG2.real**2 + MGA**2) +0.5*varepMG2.real))**(alphaG) # Biswald 2008 (je l'aime pas tant ce papier), Jacques 2013
	nMGii=   (np.sqrt(0.5*np.sqrt(varepMG2.real**2 + MGA**2) -0.5*varepMG2.real))**(2)   # Gebhart 2006  ; Yaroslavsky2002 (Optical properties of selected native...)
	LCFA= abs(varepLCF2.imag)
	nLCF= (np.sqrt(0.5*np.sqrt(varepLCF2.real**2 + LCFA**2) +0.5*varepLCF2.real))**(alphaL)#  Penfold 1929 - CSF (refractive index...); Khan 2021
	nLCFii= (np.sqrt(0.5*np.sqrt(varepLCF2.real**2 + LCFA**2) -0.5*varepLCF2.real)) #  Wang 2020 (Terahertz spectroscopic diagnosis of early...)
	DUA= abs(varepDu2.imag)
	nDu= (np.sqrt(0.5*np.sqrt(varepDu2.real**2 + DUA**2) +0.5*varepDu2.real ))**(alphaD)  # Nagel 2018 et Genina 2005
	nDuii=(np.sqrt(0.5*np.sqrt(varepDu2.real**2 + DUA**2) -0.5*varepDu2.real ))*np.exp(-2*np.pi*w/0.63E14) # Shappey 2022 (Optical properties of human...):Genina2005 (optical clearing...); Filatova2017 (Optical properties...)  comportement exponentielle

	KDu =   2*np.pi*w*nDu/lumiere # Relation de dispersion, k =\omega n/c, mais ici mon w est en Hz, il faut donc multiplie w par 2 pi
	KapDu =   2*np.pi*w*nDuii/lumiere # Relation de dispersion, k =\omega n/c, mais ici mon w est en Hz, il faut donc multiplie w par 2 pi
	KLCF =   2*np.pi*w*nLCF/lumiere # Relation de dispersion, k =\omega n/c, mais ici mon w est en Hz, il faut donc multiplie w par 2 pi
	KapLCF=      2*np.pi*w*nLCFii/lumiere # Relation de dispersion, k =\omega n/c, mais ici mon w est en Hz, il faut donc multiplie w par 2 pi
	KMB =   2*np.pi*w*nMB/lumiere #k3 # Relation de dispersion, k =\omega n/c, mais ici mon w est en Hz, il faut donc multiplie w par 2 pi
	KapMB =     2*np.pi*w*nMBii/lumiere #  Relation de dispersion, k =\omega n/c, mais ici mon w est en Hz, il faut donc multiplie w par 2 pi
	KMG =   2*np.pi*w*nMG/lumiere #k3 # Relation de dispersion, k =\omega n/c, mais ici mon w est en Hz, il faut donc multiplie w par 2 pi
	KapMG =    2*np.pi*w*nMGii/lumiere #  Relation de dispersion, k =\omega n/c, mais ici mon w est en Hz, il faut donc multiplie w par 2 pi

	ovsG =  abs(varepMG2.real)/abs(varepMG2.imag) # 2*np.pi*w *permvide* varepMG2.real/ sigmMG2 # sigmaMG # (KMG + 1j*KapMG) / np.sqrt( (1j*1.25663706127E-6* sigmMG2*(2*np.pi*w) - (KMG + 1j*KapMG)**2)) # 
	ovsB =  abs(varepMB2.real)/abs(varepMB2.imag) #2 * np.pi * w * permvide* varepMB2.real/  sigMb2 # sigmaMB # (KMB + 1j*KapMB) / np.sqrt( (1j*1.25663706127E-6* sigMb2*(2*np.pi*w) - (KMB + 1j*KapMB)**2)) # 
	ovsD =  abs(varepDu2.real)/abs(varepDu2.imag) #2* np.pi * w * permvide* varepDu2.real/ sigDu2 # sigmaDu # (KDu + 1j*KapDu) / np.sqrt( (1j*1.25663706127E-6* sigDu2*(2*np.pi*w) - (KDu + 1j*KapDu)**2)) # 
	ovsL =  abs(varepLCF2.real)/abs(varepLCF2.imag) #2 * np.pi * w * permvide* varepLCF2.real/ sigLCF2 # (KLCF + 1j*KapLCF) / np.sqrt( (1j*1.25663706127E-6* sigLCF2*(2*np.pi*w) - (KLCF + 1j*KapLCF)**2)) #  sigmaLCF # 

	lslG = 5E-3 / (2*np.pi / np.sqrt(KMG**2 )) #(lumiere/nMG)
	lslB = 4.4E-3 / (2*np.pi / np.sqrt(KMB**2)) #(lumiere/nMB)
	lslD = 0.44E-3 / (2*np.pi / np.sqrt(KDu**2)) #(lumiere/nDu)
	lslL = 2.38E-3 / (2*np.pi / np.sqrt(KLCF**2)) #(lumiere/nLCF)

	glG = (2*np.pi*w/lumiere)* np.sqrt(nMG**2 + nMGii**2) * 5E-3 # np.sqrt( KMG**2 + KapMG**2  )* 5E-3 
	glB = np.sqrt( KMB**2 + KapMB**2) * 4.4E-3 
	glD = np.sqrt(KDu**2 + KapDu**2) *0.44E-3 
	glL = np.sqrt( KLCF**2 + KapLCF**2)*2.38E-3

	tglG = 1E-6 * 2*np.pi*w * np.sqrt(sigmMG2.real**2 + (2*np.pi*2*varepMG2.real )**2   )/(KMG**2 + KapMG**2)
	tglB = 1E-6 * 2*np.pi*w * np.sqrt(sigMb2.real **2 + (2*np.pi*2*varepMB2.real )**2   )/(KMB**2 + KapMB **2)
	tglD = 1E-6 * 2*np.pi*w * np.sqrt(sigDu2.real**2 + (2*np.pi*2*varepDu2.real )**2   )/(KDu**2 + KapDu **2)
	tglL = 1E-6 * 2*np.pi*w * np.sqrt(sigLCF2.real**2 + (2*np.pi*2*varepLCF2.real )**2   )/(KLCF**2 + KapLCF**2)

	aa=0
	if aa==0:
		T4cMgP.append(ovsG) #4 couches chemin long 
		T4cMgP2.append(ovsB) #4 couches chemin court 
		T3cMb2.append(ovsD) # 3 couches matière blanche
		T3cMg.append(ovsL)  # 3 couches matière grise
