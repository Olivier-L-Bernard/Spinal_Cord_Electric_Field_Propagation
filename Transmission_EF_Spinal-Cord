import numpy as np
import math
from matplotlib import pyplot as plt, ticker as mticker
"""
Works from 0 to 1E12 Hz since at low f, the capacitive terms -> 0
"""
# np.trapz a ete retire dans NumPy 2.x
trapz = getattr(np, "trapezoid", None) or np.trapz
# =========================================================================
# 1. PARAMÈTRES ET CONSTANTES (Gabriel et al. 1996)
# =========================================================================
alphaMB = [0.1, 0.1, 0.3, 0.02]
DpermMB = [32, 100, 4E4, 3.5E7]
tauMB = [7.96E-12, 7.96E-9, 53.05E-6, 7.958E-3]
sigmaMB = 0.02

alphaMG = [0.1, 0.15, 0.22, 0.00]
DpermMG = [45, 400, 2E5, 4.5E7]
tauMG = [7.96E-12, 15.92E-9, 106.1E-6, 5.305E-3]
sigmaMG = 0.02

alphaDu = [0.15, 0.1, 0.2, 0]
perminfDu = 4
DpermDu = [40, 200, 10000, 1E6]
tauDu = [7.958E-12, 7.958E-9, 1.592E-4, 1.592E-2]
sigmaDu = 0.06

sigmaLCF = 1.7
alphaLCF = [0.1, 0, 0, 0]
perminfLCF = 4
DpermLCF = [65, 40, 0, 0]
tauLCF = [7.958E-12, 1.592E-9, 1.592E-4, 1.592E-2]

perminf = 4
permvide = 8.8541878128E-12
lumiere = 2.998E8

# Épaisseurs des couches (m) : VRAIES épaisseurs, pas des positions cumulées
d_du = 0.44E-3      # dura
a_val = 2.38E-3     # CSF #3.57E-3 to check if second peak moves (if so, it's a geometric effect)
b_val = 4.4E-3      # matière blanche, config "long"
b_val2 = 1.2E-3     # matière blanche, config "court"

# Liste pour stocker le résultat pour chaque fréquence
g00_final = []
g00_final2 = []
g00_final3 = []
g00_final4 = []
g00_final5 = []

pct_csf_entry = []
pct_wm_entry = []
pct_gm_entry = []
pct_gms_entry = []
pct_gm3_entry = []

we = 1e-3
kk = np.linspace(-2*np.pi/we, 2*np.pi/we, 6000)
omega2 = np.logspace(1, 11, num=85, endpoint=True, base=10.0)
cutooff = 0.4E8

font=31
fig, ax = plt.subplots(ncols=1, nrows=1,sharex = True,figsize=(13,8)) 
plt.hlines(y=0,xmin=0,xmax=1E11,linewidth=2,color='grey',linestyle='dashed') #Guider l'oeil à 0
plt.axvline(x=4E7,ymin= -0.5/36.5, ymax= 17.7/36.5, linewidth= 2, linestyle ='dashed',color='grey') #Endroit du pulse clinique si on m'a bien expliqué. Sinon, c'est 3.3 kHz

# =========================================================================
# 2. BOUCLE DE CALCUL NUMÉRIQUE VIA NUMPY
# =========================================================================
for w in omega2:
    sigmMG = 0; sigDu = 0; sigMb = 0; sigLCF = 0
    varepMG = 0; varepMB = 0; varepDu = 0; varepLCF = 0

    # Calculs Cole-Cole
    for i in range(len(alphaMG)):
        term_mg  = 1 + (1j * 2 * np.pi * w * tauMG[i])**(1 - alphaMG[i])
        term_du  = 1 + (1j * 2 * np.pi * w * tauDu[i])**(1 - alphaDu[i])
        term_mb  = 1 + (1j * 2 * np.pi * w * tauMB[i])**(1 - alphaMB[i])
        term_lcf = 1 + (1j * 2 * np.pi * w * tauLCF[i])**(1 - alphaLCF[i])

        varepMG  += DpermMG[i] / term_mg
        varepDu  += DpermDu[i] / term_du
        varepMB  += DpermMB[i] / term_mb
        varepLCF += DpermLCF[i] / term_lcf


    # Permittivités complexes globales
    varepMBB  = perminf + varepMB + sigmaMB / (1j * (w * 2 * np.pi * permvide))
    varepMGG  = perminf + varepMG + sigmaMG / (1j * (w * 2 * np.pi * permvide))
    varepDuu  = perminfDu + varepDu + sigmaDu / (1j * (w * 2 * np.pi * permvide))
    varepLCFF = perminfLCF + varepLCF + sigmaLCF / (1j * (w * 2 * np.pi * permvide))

    varepMB2 = varepMBB.real + 1j*abs(varepMBB.imag)
    varepMG2 = varepMGG.real + 1j*abs(varepMGG.imag)
    varepDu2 = varepDuu.real + 1j*abs(varepDuu.imag)
    varepLCF2 = varepLCFF.real + 1j*abs(varepLCFF.imag)

    sigd = -1j*2*np.pi*w*permvide*(varepDu2)
    sigl = -1j*2*np.pi*w*permvide*(varepLCF2)
    sigw = -1j*2*np.pi*w*permvide*(varepMB2)
    sigg = -1j*2*np.pi*w*permvide*(varepMG2)

    # Indices de réfraction (Réels et Imaginaires)
    MBA   = varepMB2.imag
    nMB   = (np.sqrt(0.5 * (np.sqrt(varepMB2.real**2 + MBA**2) + varepMB2.real)))
    nMBii = (np.sqrt(0.5 * (np.sqrt(varepMB2.real**2 + MBA**2) - varepMB2.real)))

    MGA   = abs(varepMG2.imag)
    nMG   = (np.sqrt(0.5 * np.sqrt(varepMG2.real**2 + MGA**2) + 0.5 * varepMG2.real))
    nMGii = (np.sqrt(0.5 * np.sqrt(varepMG2.real**2 + MGA**2) - 0.5 * varepMG2.real))

    LCFA   = abs(varepLCF2.imag)
    nLCF   = (np.sqrt(0.5 * np.sqrt(varepLCF2.real**2 + LCFA**2) + 0.5 * varepLCF2.real))
    nLCFii = (np.sqrt(0.5 * np.sqrt(varepLCF2.real**2 + LCFA**2) - 0.5 * varepLCF2.real))

    DUA   = abs(varepDu2.imag)
    nDu   = (np.sqrt(0.5 * np.sqrt(varepDu2.real**2 + DUA**2) + 0.5 * varepDu2.real))
    nDuii = (np.sqrt(0.5 * np.sqrt(varepDu2.real**2 + DUA**2) - 0.5 * varepDu2.real))

    # Relations de dispersion (k et \kappa)
    KDu    = 2 * np.pi * w * nDu / lumiere
    KapDu  = 2 * np.pi * w * nDuii / lumiere
    KLCF   = 2 * np.pi * w * nLCF / lumiere
    KapLCF = 2 * np.pi * w * nLCFii / lumiere
    KMB    = 2 * np.pi * w * nMB / lumiere
    KapMB  = 2 * np.pi * w * nMBii / lumiere
    KMG    = 2 * np.pi * w * nMG / lumiere
    KapMG  = 2 * np.pi * w * nMGii / lumiere

    kkd = KDu + 1j*KapDu
    kkl = KLCF + 1j*KapLCF
    kkw = KMB + 1j*KapMB
    kkg = KMG + 1j*KapMG

    xk = []
    fonction4l = []
    fonction4ld = []
    fonction4c = []
    fonction4cd = []
    fonction3w = []
    fonction3wd = []
    fonction3g = []
    fonction3gd = []
    fonction2 = []
    fonction2d = []

    p_dura_in_4c = []
    p_dura_in_4cl = []
    p_dura_in_3w = []
    p_dura_in_3g = []
    p_dura_in_2c = []

    f_pin = []
    f_csf = []
    f_wm = []
    f_gm = []
    f_gms = []
    f_gm3 = []



    # -------------------------------------------------------------------------
    # GESTION COUCHES MATRICIELLES COMPLEXES (1=Dura, 2=CSF, 3=Matière blanche, 4=Matière grise)
    # -------------------------------------------------------------------------
    ij=0

    for kx in kk:

        if w < cutooff :
            gamd = np.sqrt(kx**2) # - kkd**2)
            gaml = np.sqrt(kx**2) # - kkl**2)
            gamw = np.sqrt(kx**2) # - kkw**2)
            gamg = np.sqrt(kx**2) # - kkg**2)
            gamQ = kx
        if w >= cutooff :
            gamd = np.sqrt(kx**2 - kkd**2)
            gaml = np.sqrt(kx**2 - kkl**2)
            gamw = np.sqrt(kx**2 - kkw**2)
            gamg = np.sqrt(kx**2 - kkg**2)
            gamQ = kx

        yd = (sigd/gamd)
        yl = (sigl/gaml)
        yw = (sigw/gamw)
        yg = (sigg/gamg)

        sinc_kx = np.sinc(kx * we / (2 * np.pi))
        s2 = kx**2 *abs(sinc_kx)**2

        # ---------------------------------------------------------------------
        # Matrices de couche INVERSES (on part du dernier milieu vers l'électrode)
        # Forme "scalée" : inverse vraie [[ch, sh/y],[y sh, ch]] * exp(-gam*t)
        # => entrées bornées, aucun overflow à grand kx
        # ---------------------------------------------------------------------
        md = 0.5*np.array([[ 1 + np.exp(-2*gamd*d_du), 1/yd*(1-np.exp(-2*gamd*d_du) )],
            [yd * (1 -np.exp(-2*gamd*d_du)),  1 + np.exp(-2*gamd*d_du)]], dtype=complex)

        ml = 0.5*np.array([[ 1 + np.exp(-2*gaml*a_val), 1/yl*(1 -np.exp(-2*gaml*a_val) )],
            [yl * (1 -np.exp(-2*gaml*a_val)),  1 + np.exp(-2*gaml*a_val)]], dtype=complex)

        mw = 0.5*np.array([[ 1 + np.exp(-2*gamw*b_val), 1/yw*(1-np.exp(-2*gamw*b_val) )],
            [yw * (1 -np.exp(-2*gamw*b_val)),  1 + np.exp(-2*gamw*b_val)]], dtype=complex)

        mwl = 0.5*np.array([[ 1 + np.exp(-2*gamw*b_val2), 1/yw*(1-np.exp(-2*gamw*b_val2) )],
            [yw * (1 -np.exp(-2*gamw*b_val2)),  1 + np.exp(-2*gamw*b_val2)]], dtype=complex)

        # Gamma = somme gam*t : [E0,H0]_vrai = exp(Gamma) * [E0,H0]_scalé
        smot  = gamd*d_du + gaml*a_val + gamw*b_val     # 4c long
        smotl = gamd*d_du + gaml*a_val + gamw*b_val2    # 4c court
        smot2 = gamd*d_du + gaml*a_val                  # 3c (dura + CSF)
        smot3 = gamd*d_du                               # CSF seul (dura)

        # Condition de sortie : onde sortante seulement dans le dernier milieu
        # H_L = y_L * E_L, avec E_L = 1
        vg  = np.array([1, yg], dtype=complex)
        vw  = np.array([1, yw], dtype=complex)
        vl  = np.array([1, yl], dtype=complex)

        # [E0,H0] a la surface de l'electrode (scalé par exp(-Gamma))
        GM  = md @ ml @ mw  @ vg      # 4c long   -> grey matter
        GMl = md @ ml @ mwl @ vg      # 4c court  -> grey matter
        GW  = md @ ml @ vw            # 3c MB     -> dernier milieu = MB
        GM3 = md @ ml @ vg            # 3c MG     -> dernier milieu = MG
        GH  = md @ vl                 # CSF       -> dernier milieu = CSF
        vg_gm = np.array([1, yg], dtype=complex)
        vg_wml = mwl @ vg_gm
        vg_wm = mw @ vg_gm
        vg_csf = ml @ vg_wm 
        v_0 = md @ vg_csf

        eraw = v_0[0]
        scale_0 = s2 / (abs(eraw) ** 2)
        scale_csf = scale_0 * np.exp(-2 * smot3.real)
        scale_wm = scale_0 * np.exp(-2 * smot2.real)
        scale_gm = scale_0 * np.exp(-2 * smot.real)
        scale_gms = scale_0 * np.exp(-2 * smotl.real)
        scale_gm3 = scale_0 * np.exp(-2 * smot2.real)

        f_pin.append(0.5 * scale_0 * np.real(v_0[0] * np.conj(v_0[1])))
        f_csf.append(0.5 * scale_csf * np.real(vg_csf[0] * np.conj(vg_csf[1])))
        f_wm.append(0.5 * scale_wm * np.real(vg_wm[0] * np.conj(vg_wm[1])))
        f_gm.append(0.5 * scale_gm * np.real(vg_gm[0] * np.conj(vg_gm[1])))
        f_gms.append(0.5 * scale_gms * np.real(vg_gm[0] * np.conj(vg_gm[1])))
        f_gm3.append(0.5 * scale_gm3 * np.real(vg_gm[0] * np.conj(vg_gm[1]))) 

        # Champ E a la surface (scalé) et admittance d'entree (sans echelle)
        eraw  = GM[0]  ; hraw  = GM[1]
        erawl = GMl[0] ; hrawl = GMl[1]
        eraw2 = GW[0]  ; hraw2 = GW[1]
        erawg = GM3[0] ; hrawg = GM3[1]
        eraw3 = GH[0]  ; hraw3 = GH[1]

        Yin4c  = hraw/eraw
        Yin4l  = hrawl/erawl
        Yin3w  = hraw2/eraw2
        Yin3g  = hrawg/erawg
        Yin2   = hraw3/eraw3

        

        # NUMERATEUR : puissance livree au dernier milieu pour E_surface = sinc
        #   0.5*Re(y_L)*|E_L|^2 ,  |E_L|^2 = s2 * exp(-2 Re Gamma) / |E0_scalé|^2

        
        fct4c  = 0.5*yg.real*s2*abs(np.exp(-smot.real) )**2/abs(eraw)**2
        fct4cl = 0.5*yg.real*s2*abs(np.exp(-smotl.real))**2/abs(erawl)**2
        fct3cw = 0.5*yw.real*s2*abs(np.exp(-smot2.real))**2/abs(eraw2)**2
        fct3cg = 0.5*yg.real*s2*abs(np.exp(-smot2.real))**2/abs(erawg)**2
        fct2cs = 0.5*yl.real*s2*abs(np.exp(-smot3.real))**2/abs(eraw3)**2

        # DENOMINATEUR : puissance entrant dans l'empilement a l'electrode
        # (0.5*Re(Yin)*|sinc|^2). Pour comparer a une dura semi-infinie,
        # remplacer Yin.real par yd.real (des valeurs > 100% deviennent alors possibles).
        fct4cd  = 0.5*Yin4c.real*s2
        fct4cld = 0.5*Yin4l.real*s2
        fct3cwd = 0.5*Yin3w.real*s2
        fct3cgd = 0.5*Yin3g.real*s2
        fct2csd = 0.5*Yin2.real*s2

        ij+=1
        xk.append(kx)

        p_dura_in_4c.append(0.5 * (s2 / abs(GM[0]) ** 2) * np.real(GM[0] * np.conj(GM[1])))
        p_dura_in_4cl.append(0.5 * (s2 / abs(GMl[0]) ** 2) * np.real(GMl[0] * np.conj(GMl[1])))
        p_dura_in_3w.append(0.5 * (s2 / abs(GW[0]) ** 2) * np.real(GW[0] * np.conj(GW[1])))
        p_dura_in_3g.append(0.5 * (s2 / abs(GM3[0]) ** 2) * np.real(GM3[0] * np.conj(GM3[1])))
        p_dura_in_2c.append(0.5 * (s2 / abs(GH[0]) ** 2) * np.real(GH[0] * np.conj(GH[1])))


        fonction4c.append(fct4c)
        fonction4cd.append(fct4cd)
        fonction4l.append(fct4cl)
        fonction4ld.append(fct4cld)
        fonction3w.append(fct3cw)
        fonction3wd.append(fct3cwd)
        fonction3g.append(fct3cg)
        fonction3gd.append(fct3cgd)
        fonction2.append(fct2cs)
        fonction2d.append(fct2csd)

    den = trapz(f_pin, kk)

    pct_csf_entry.append(100.0 * trapz(f_csf, kk) / den)
    pct_wm_entry.append(100.0 * trapz(f_wm, kk) / den)
    pct_gm_entry.append(100.0 * trapz(f_gm, kk) / den)
    pct_gms_entry.append(100.0 * trapz(f_gms, kk) / den)
    pct_gm3_entry.append(100.0 * trapz(f_gm3, kk) / den)

    den_4c = trapz(p_dura_in_4c, kk)
    den_4cl = trapz(p_dura_in_4cl, kk)
    den_3w = trapz(p_dura_in_3w, kk)
    den_3g = trapz(p_dura_in_3g, kk)
    den_2c = trapz(p_dura_in_2c, kk)

    G2 = trapz( fonction4c, xk)/den_4c #trapz( fonction4cd, xk)
    GG2 = trapz( fonction4l, xk)/den_4cl #trapz( fonction4ld, xk)
    GGG2 = trapz( fonction3w, xk)/den_3w #trapz( fonction3wd, xk)
    GGGG2 = trapz( fonction3g,xk)/den_3g #trapz( fonction3gd, xk)
    GH2 = trapz( fonction2, xk)/den_2c #trapz( fonction2d, xk)
    #print(w,GGG2)
    # Stockage
    g00_final.append(100*G2)
    g00_final2.append(100*GG2)
    g00_final3.append(100*GGG2)
    g00_final4.append(100*GGGG2)
    g00_final5.append(100*GH2)
    print(ij)
# Conversion de la liste en tableau de résultats NumPy


